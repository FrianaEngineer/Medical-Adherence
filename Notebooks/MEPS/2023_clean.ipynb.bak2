   "outputs": [],
   "source": [
    "grouped_merge_df[\"total_valid_days\"] = np.minimum(grouped_merge_df[\"RXDAYSUP\"], 365).astype(int)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "51608a32",
   "metadata": {},
   "outputs": [],
   "source": [
    "grouped_merge_df[\"total_days_supply\"] = np.where(grouped_merge_df[\"RXBEGYRX\"] <=2023, 365,0).astype(int)"
   ]
  },
