   "source": [
    "rx_counts = model_df[\"RXNAME\"].value_counts(dropna=False)\n",
    "n_once = int((rx_counts >9).sum())\n",
    "\n",
    "print(f\"unique RXNAME: {rx_counts.shape[0]}\")\n",
