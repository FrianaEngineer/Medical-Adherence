  {
   "cell_type": "code",
   "execution_count": 69,
   "id": "bbd4c377",
   "metadata": {},
   "outputs": [],
   "source": [
    "delay_df = demo_df[[\"DUPERSID\", \"DLAYPM42\", \"DLAYCA42\"]].drop_duplicates(\"DUPERSID\")\n",
    "new_grouped_merge_df = new_grouped_merge_df.drop(\n",
    "    columns=[\"DLAYPM42\", \"DLAYCA42\"], errors=\"ignore\"\n",
    ").merge(delay_df, on=\"DUPERSID\", how=\"left\")\n",
    "\n",
    "model_df = new_grouped_merge_df[['DUPERSID','RXNAME','ICD10CDX','ICD10CDX_LABEL','AGE23X','SEX','INSCOV23',\n",
    " 'POVCAT23','FAMINC23','RACEV2X','DLAYPM42','DLAYCA42','meps_adherence_ratio']]"
   ]
  },
