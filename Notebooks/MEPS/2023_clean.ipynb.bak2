       "9  2790012102         True         True         True     2023-01-01   \n",
       "\n",
       "  ref_end_2023  total_days_supply participation_type           coverage_notes  \\\n",
       "0   2023-12-31                365          full_year  full_year_all_rounds_11   \n",
       "1   2023-12-31                365          full_year  full_year_all_rounds_11   \n",
