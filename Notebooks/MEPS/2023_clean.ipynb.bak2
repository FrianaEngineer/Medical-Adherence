    "print(f\"ICD10CDX appearing exactly once: {n_once}\")\n",
    "print(f\"share of unique codes: {100 * n_once / icd_counts.shape[0]:.1f}%\")\n",
    "print(f\"share of rows: {100 * n_once / len(model_df):.1f}%\")\n",
    "icd_counts[icd_counts >9]\n"
   ]
