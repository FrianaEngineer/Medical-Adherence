    "grouped_merge_df[\"meps_adherence_ratio\"] = np.where(\n",
    "    grouped_merge_df[\"total_days_supply\"].eq(0),\n",
    "    np.nan,\n",
    "    grouped_merge_df[\"total_valid_days\"] / grouped_merge_df[\"total_days_supply\"] * 100,\n",
    ")\n",
    "grouped_merge_df.head()\n"
   ]
